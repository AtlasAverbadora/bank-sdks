{
  "name": "@atlas/averbacao-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./http": { "types": "./dist/adapters/http.d.ts", "default": "./dist/adapters/http.js" },
    "./fastify": { "types": "./dist/adapters/fastify.d.ts", "default": "./dist/adapters/fastify.js" },
    "./examples": { "types": "./dist/examples/index.d.ts", "default": "./dist/examples/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" },
    "./openapi": { "types": "./dist/openapi/index.d.ts", "default": "./dist/openapi/index.js" }
  },
  "bin": { "atlas-sdk": "./dist/cli/index.js" },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "prepare": "pnpm build"
  },
  "dependencies": { "fastify": "5.11.3", "zod": "^3.25.76", "zod-to-json-schema": "^3.25.2" },
  "devDependencies": { "@types/node": "^20.14.10", "typescript": "^5.5.3" }
}
